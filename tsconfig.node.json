{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "resolveJsonModule": true
  },
  "include": [
    "vite.config.ts",
    "vite.server.config.ts",
    "playwright.config.ts",
    "scripts/**/*.ts",
    "e2e/**/*.ts",
    "server/**/*.ts",
    "tests/server*.test.ts"
  ]
}
