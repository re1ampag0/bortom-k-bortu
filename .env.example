# Copy this file to .env and fill it in (DEPLOY.md).

# The port of the simple variant: the game is at http://<IP of the server>:PORT
PORT=8080

# The full variant (docker-compose.https.yml): your domain or subdomain, e.g. bortom.duckdns.org
DOMAIN=

# Pages of other sites allowed to connect to the server, comma-separated: the site on GitHub Pages.
# Empty — any site may connect.
ALLOWED_ORIGINS=https://re1ampag0.github.io

# The password of «Админка → Сервер» (uploading and deleting presets). Write your own; empty — uploading is off.
# The file .env is not in git: the password stays on this computer or server.
ADMIN_PASSWORD=
